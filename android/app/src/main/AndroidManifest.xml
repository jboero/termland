<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Used only to show "you are offline" style state and to decide whether a
         resume attempt is worth making. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The primary target is a tablet with a real keyboard and mouse, but none of
         these are hard requirements: touch-only devices fall back to the on-screen
         modifier bar and the touch gestures. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />

    <application
        android:name=".TermlandApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Termland">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The viewer handles every configuration change itself: a rotation or a
             keyboard being plugged in must NOT recreate the activity, because that
             would tear down the Surface and the MediaCodec instance behind it. We
             react by resizing the remote session instead (SessionActivity.
             surfaceChanged -> client.resize).

             sensorLandscape rather than a locked orientation: desktop sessions are
             landscape, but a tablet flipped 180 degrees in a keyboard case must
             still work. -->
        <activity
            android:name=".session.SessionActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|touchscreen|locale"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.Termland.Viewer"
            android:windowSoftInputMode="adjustNothing" />
    </application>

</manifest>
