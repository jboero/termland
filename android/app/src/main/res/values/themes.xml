<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose supplies all the real styling; these platform themes only need to
         give us a no-action-bar window. Parenting to the platform DeviceDefault
         theme avoids pulling in appcompat for nothing. -->
    <style name="Theme.Termland" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
    </style>

    <!-- Viewer: opaque black behind the video, no transitions. A black window
         background matters because the SurfaceView punches a transparent hole in
         the window and anything else would show through as letterboxing. -->
    <style name="Theme.Termland.Viewer" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
