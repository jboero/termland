# Termland Remote Desktop Server - systemd service unit
#
# This runs termland-server as a TCP listener with TLS and PAM authentication.
# For SSH subsystem mode, you don't need this service - just add to sshd_config:
#   Subsystem termland /usr/bin/termland-server --subsystem
#
# Installation:
#   cp termland-server.service /usr/lib/systemd/system/
#   cp termland-server.env /etc/sysconfig/termland-server
#   systemctl daemon-reload
#   systemctl enable --now termland-server
#
# The server needs root for PAM authentication. Each session runs a headless
# Wayland compositor, so the system needs: labwc or cage, a Wayland-compatible
# GPU driver (or software rendering via llvmpipe), and PulseAudio for audio.

[Unit]
Description=Termland Remote Desktop Server
Documentation=https://github.com/jboero/termland
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as root for PAM auth. If you don't need PAM (e.g. SSH-only deployment),
# you can run as a dedicated user instead:
#   User=termland
#   Group=termland
User=root
Group=root

# Defaults, so a missing or partially-commented environment file still yields a
# complete command line. EnvironmentFile= is applied after these and overrides
# them, so /etc/sysconfig/termland-server stays the place to configure this.
# --bind mirrors the packaged default (0.0.0.0), not the binary's 127.0.0.1.
Environment=TERMLAND_BIND=0.0.0.0
Environment=TERMLAND_PORT=7867

# Load configuration from environment file
EnvironmentFile=-/etc/sysconfig/termland-server

# Main command - flags are controlled via the environment file.
#
# The flag variables are expanded UNBRACED, and that is load-bearing. Per
# systemd.service(5), "${VAR}" always produces exactly one argument including
# any whitespace, whereas "$VAR" is split at whitespace into zero or more
# arguments (honouring quotes, so a path containing spaces still survives).
# Braced, TERMLAND_TLS_FLAGS="--tls --tls-cert c.pem --tls-key k.pem" reaches
# the server as a single unparseable argument, and an empty value becomes an
# empty argument the parser also rejects. Unbraced, both work.
#
# --bind/--port stay braced: each is one value that must remain one argument,
# and the Environment= lines above guarantee they are never empty.
ExecStart=/usr/bin/termland-server \
    --bind ${TERMLAND_BIND} \
    --port ${TERMLAND_PORT} \
    $TERMLAND_TLS_FLAGS \
    $TERMLAND_AUTH_FLAGS

# Restart on crash, but not on clean exit (e.g. SIGTERM)
Restart=on-failure
RestartSec=5

# Security hardening.
#
# Scope note: this sandbox is inherited by everything the service spawns —
# which here means whole user desktop sessions, not just a network daemon.
# Whatever the sandbox forbids, a remote user's desktop cannot do either.
#
# ProtectHome= is deliberately NOT set. Per systemd.exec(5) it covers /home,
# /root *and* /run/user, and this service must write all three: sessions
# write to the user's home directory, the first-run TLS cert used to land
# under /root, and each isolated session needs its own /run/user/<uid> for
# the Wayland socket. ProtectHome=read-only broke session startup outright.
NoNewPrivileges=false
ProtectSystem=strict
ReadWritePaths=/run /tmp /home

# Note there is deliberately no write access to /etc here: the TLS keypair is
# created at package install time (the RPM's %post runs
# "termland-server --generate-cert"), so the daemon only ever reads it. If it
# is ever missing, regenerate with that same command rather than loosening
# the sandbox.
PrivateTmp=true

# Session registry + compositor logs. These used to land in /run/user/0,
# which logind creates only for a real root login and removes when the last
# one ends — deleting live state under a running service. RuntimeDirectory
# gives us a dir that is ours unconditionally; Preserve=yes keeps detached
# sessions trackable across a server restart (they outlive it by design),
# while still clearing on reboot.
RuntimeDirectory=termland
RuntimeDirectoryPreserve=yes
Environment=XDG_RUNTIME_DIR=/run/termland

# Allow binding to privileged ports if needed
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Logging goes to journald via stderr
StandardOutput=journal
StandardError=journal
SyslogIdentifier=termland-server

# Resource limits - each session spawns a compositor + encoder
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
